# The Actions budget basstler holds every workflow in .github/workflows to. The limits
# below apply to every workflow; a [{{ workflow_key }}."<file>"] table changes them for
# that workflow alone. Edit this file by hand from here on.

{% for name, value in defaults.items() %}
{{ name }} = {{ value | tojson }}
{% endfor %}
{% for file_name, limits in overrides.items() %}

[{{ workflow_key }}.{{ file_name | tojson }}]
{% for name, value in limits.items() %}
{{ name }} = {{ value | tojson }}
{% endfor %}
{% endfor %}
